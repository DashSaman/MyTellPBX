          gap: 10px 16px;
        }

        .mytel-clean-actions {
          min-width: 0;
          width: 100%;
          justify-content: center;
          flex-wrap: wrap;
        }

        .mytel-clean-menu .current-menu-item > a:after,
        .mytel-clean-menu .current_page_item > a:after {
          bottom: -5px;
        }
      }

      @media (max-width: 560px) {
        .mytel-clean-menu a {
          font-size: 12px;
        }

        .mytel-clean-logo-text {
          font-size: 25px;
        }

        .mytel-clean-logo-icon {
          width: 58px;
        }

        .mytel-clean-phone,
        .mytel-clean-cta {
          min-width: 135px;
        }
      }
