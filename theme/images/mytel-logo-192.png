    background: rgba(22,139,255,.22) !important;
    border-color: rgba(22,139,255,.55) !important;
  }

  .mytel-page .mytel-menu a.active:after {
    display: none !important;
  }
}

@media (max-width: 420px) {
  .mytel-page .mytel-menu,
  .mytel-page .mytel-nav {
    gap: 7px !important;
    padding: 0 4px !important;
  }

  .mytel-page .mytel-menu a,
  .mytel-page .mytel-nav a {
    height: 36px !important;
    padding: 0 11px !important;
    font-size: 12px !important;
  }

  .mytel-page .mytel-brand-svg {
    width: 60px !important;
    height: 44px !important;
  }

  .mytel-page .mytel-brand-text,
  .mytel-page .mytel-logo-text {
    font-size: 25px !important;
  }
}
</style>
<style id="mytel-mobile-nav-v2-css">

#mytel-mnav{
    display:none;
}

@media (max-width:900px){

    html,
    body{
        overflow-x:hidden!important;
        max-width:100%!important;
    }

    body{
        padding-top:68px!important;
    }

    /*
     * Disable BOTH existing desktop and theme mobile headers.
     * This prevents the wrapped desktop menu and the white Blocksy drawer
     * seen in the screenshots.
     */
    [data-elementor-id="115"],
    [data-elementor-type="header"],
    .elementor-location-header,
    #header,
    header#header,
    .ct-header,
    .site-header,
    .ct-header-trigger,
    .ct-drawer-canvas,
    .ct-panel,
    .ct-offcanvas,
    #offcanvas,
    .mobile-menu-container{
        display:none!important;
        width:0!important;
        height:0!important;
        min-height:0!important;
        max-height:0!important;
        margin:0!important;
        padding:0!important;
        overflow:hidden!important;
        visibility:hidden!important;
        pointer-events:none!important;
    }

    #mytel-mnav{
        display:block!important;
        width:100%!important;
        height:68px!important;
        min-height:68px!important;
        max-height:none!important;
        margin:0!important;
        padding:0!important;
        overflow:visible!important;
        visibility:visible!important;
        pointer-events:auto!important;
    }

    .mytel-mnav{
        position:fixed!important;
        top:0!important;
        right:0!important;
        left:0!important;
        z-index:2147483000!important;
        direction:rtl!important;
        background:#020b16!important;
        border-bottom:1px solid rgba(255,255,255,.10)!important;
        box-shadow:0 8px 26px rgba(0,0,0,.28)!important;
    }

    body.admin-bar .mytel-mnav{
        top:46px!important;
    }

    .mytel-mnav-bar{
        width:min(94%,760px)!important;
        height:68px!important;
        margin:0 auto!important;
        padding:0!important;
        display:flex!important;
        flex-direction:row!important;
        align-items:center!important;
        justify-content:space-between!important;
        gap:10px!important;
    }

    .mytel-mnav-logo{
        display:flex!important;
        align-items:center!important;
        width:auto!important;
        min-width:0!important;
        margin:0!important;
        padding:0!important;
        background:transparent!important;
        border:0!important;
    }

    .mytel-mnav-logo img{
        display:block!important;
        width:132px!important;
        max-width:132px!important;
        height:46px!important;
        max-height:46px!important;
        object-fit:contain!important;
        margin:0!important;
        padding:0!important;
    }

    .mytel-mnav-actions{
        display:flex!important;
        align-items:center!important;
        justify-content:flex-end!important;
        gap:8px!important;
        margin:0!important;
        padding:0!important;
        flex:0 0 auto!important;
    }

    .mytel-mnav-phone{
        display:flex!important;
        align-items:center!important;
        justify-content:center!important;
        min-height:38px!important;
        padding:7px 10px!important;
        margin:0!important;
        border:1px solid #d97500!important;
        border-radius:10px!important;
        background:rgba(255,137,0,.05)!important;
        color:#ff9417!important;
        -webkit-text-fill-color:#ff9417!important;
        font-size:12px!important;
        line-height:1!important;
        font-weight:950!important;
        text-decoration:none!important;
        direction:ltr!important;
        white-space:nowrap!important;
    }

    .mytel-mnav-toggle{
        display:flex!important;
        width:42px!important;
        min-width:42px!important;
        height:42px!important;
        min-height:42px!important;
        margin:0!important;
        padding:9px!important;
        flex-direction:column!important;
        align-items:center!important;
        justify-content:center!important;
        gap:5px!important;
        border:1px solid rgba(255,255,255,.14)!important;
        border-radius:11px!important;
        background:#0a1b2e!important;
        box-shadow:none!important;
        cursor:pointer!important;
    }

    .mytel-mnav-toggle span{
        display:block!important;
        width:21px!important;
        height:2px!important;
        min-height:2px!important;
        margin:0!important;
        padding:0!important;
        background:#fff!important;
        border:0!important;
        border-radius:99px!important;
        opacity:1!important;
        transition:transform .2s ease,opacity .2s ease!important;
    }

    .mytel-mnav.open .mytel-mnav-toggle span:nth-child(1){
        transform:translateY(7px) rotate(45deg)!important;
    }

    .mytel-mnav.open .mytel-mnav-toggle span:nth-child(2){
        opacity:0!important;
    }

    .mytel-mnav.open .mytel-mnav-toggle span:nth-child(3){
        transform:translateY(-7px) rotate(-45deg)!important;
    }

    .mytel-mnav-drawer{
        position:fixed!important;
        top:68px!important;
        right:0!important;
        left:0!important;
        bottom:0!important;
        width:100%!important;
        height:auto!important;
        min-height:0!important;
        max-height:none!important;
        margin:0!important;
        padding:0!important;
        overflow-y:auto!important;
        overscroll-behavior:contain!important;

        background:rgba(2,11,22,.995)!important;
        color:#fff!important;

        opacity:0!important;
        visibility:hidden!important;
        transform:translateY(-8px)!important;
        pointer-events:none!important;

        transition:
            opacity .18s ease,
            visibility .18s ease,
            transform .18s ease!important;

        z-index:2147482999!important;
    }

    body.admin-bar .mytel-mnav-drawer{
        top:114px!important;
    }

    .mytel-mnav.open .mytel-mnav-drawer{
        opacity:1!important;
        visibility:visible!important;
        transform:translateY(0)!important;
        pointer-events:auto!important;
    }

    body.mytel-mnav-lock{
        overflow:hidden!important;
        touch-action:none!important;
    }

    .mytel-mnav-panel{
        width:min(94%,620px)!important;
        margin:0 auto!important;
        padding:14px 0 34px!important;
        background:transparent!important;
        color:#fff!important;
    }

    #mytel-mnav .mytel-mnav-menu,
    #mytel-mnav .mytel-mnav-menu ul{
        display:block!important;
        width:100%!important;
        height:auto!important;
        max-height:none!important;
        margin:0!important;
        padding:0!important;
        list-style:none!important;
        background:transparent!important;
        border:0!important;
        box-shadow:none!important;
    }

    #mytel-mnav .mytel-mnav-menu > li{
        position:relative!important;
        display:block!important;
        width:100%!important;
        margin:0!important;
        padding:0!important;
        background:transparent!important;
        border-bottom:1px solid rgba(255,255,255,.08)!important;
    }

    #mytel-mnav .mytel-mnav-menu li > a{
        display:flex!important;
        width:100%!important;
        min-height:53px!important;
        margin:0!important;
        padding:12px 12px!important;
        align-items:center!important;

        background:transparent!important;
        color:#f7f9fc!important;
        -webkit-text-fill-color:#f7f9fc!important;

        border:0!important;
        border-radius:0!important;
        box-shadow:none!important;

        font-size:15px!important;
        line-height:1.8!important;
        font-weight:850!important;
        text-align:right!important;
        text-decoration:none!important;

        white-space:normal!important;
    }

    /*
     * Parents such as "خدمات" and "راهنما و ابزارها":
     * the whole row becomes the submenu opener.
     */
    #mytel-mnav .mytel-mnav-menu li.menu-item-has-children > a{
        position:relative!important;
        padding-left:46px!important;
        cursor:pointer!important;
    }

    #mytel-mnav .mytel-mnav-menu li.menu-item-has-children > a::after{
        content:""!important;
        position:absolute!important;
        left:15px!important;
        top:50%!important;
        width:9px!important;
        height:9px!important;
        border-left:2px solid #68b4ff!important;
        border-bottom:2px solid #68b4ff!important;
        transform:translateY(-65%) rotate(-45deg)!important;
        transition:transform .18s ease!important;
    }

    #mytel-mnav .mytel-mnav-menu li.menu-item-has-children.mytel-sub-open > a::after{
        transform:translateY(-35%) rotate(135deg)!important;
    }

    #mytel-mnav .mytel-mnav-menu .sub-menu{
        display:none!important;
        position:static!important;
        inset:auto!important;
        width:100%!important;
        min-width:0!important;
        max-width:100%!important;
        height:auto!important;
        margin:0!important;
        padding:4px 12px 10px!important;

        background:#071728!important;
        border:0!important;
        border-right:2px solid #168bff!important;
        border-radius:10px!important;
        box-shadow:none!important;
        opacity:1!important;
        visibility:visible!important;
        transform:none!important;
    }

    #mytel-mnav .mytel-mnav-menu li.mytel-sub-open > .sub-menu{
        display:block!important;
    }

    #mytel-mnav .mytel-mnav-menu .sub-menu li{
        display:block!important;
        width:100%!important;
        margin:0!important;
        padding:0!important;
        background:transparent!important;
        border-bottom:1px solid rgba(255,255,255,.055)!important;
    }

    #mytel-mnav .mytel-mnav-menu .sub-menu li:last-child{
        border-bottom:0!important;
    }

    #mytel-mnav .mytel-mnav-menu .sub-menu li > a{
        min-height:44px!important;
        padding:8px 10px!important;
        color:#cdddf0!important;
        -webkit-text-fill-color:#cdddf0!important;
        font-size:14px!important;
        font-weight:750!important;
    }

    #mytel-mnav .mytel-mobile-parent-destination > a{
        color:#ff9f22!important;
        -webkit-text-fill-color:#ff9f22!important;
        font-weight:900!important;
    }

    .mytel-mnav-consult{
        display:flex!important;
        width:100%!important;
        min-height:50px!important;
        margin:18px 0 0!important;
        padding:11px 16px!important;
        align-items:center!important;
        justify-content:center!important;

        border-radius:12px!important;
        border:0!important;

        background:linear-gradient(135deg,#ff9c17,#ff7a00)!important;
        color:#fff!important;
        -webkit-text-fill-color:#fff!important;

        font-size:15px!important;
        font-weight:950!important;
        text-decoration:none!important;

        box-shadow:0 12px 28px rgba(255,126,0,.20)!important;
    }

    /*
     * Prevent any page from creating horizontal mobile overflow.
     * This does NOT change desktop styles.
     */
    body > *:not(#mytel-mnav),
    main,
    .elementor,
    .elementor-section,
    .elementor-container,
    .e-con{
        max-width:100vw!important;
    }

    img,
    video,
    canvas{
        max-width:100%!important;
        height:auto;
    }
}

@media (min-width:783px) and (max-width:900px){
    body.admin-bar .mytel-mnav{
        top:32px!important;
    }

    body.admin-bar .mytel-mnav-drawer{
        top:100px!important;
    }
}

@media (max-width:390px){
    .mytel-mnav-phone{
        display:none!important;
    }

    .mytel-mnav-logo img{
        width:120px!important;
        max-width:120px!important;
    }
}

</style>
<style id="mytel-mobile-visual-v3-css">

@media (max-width:900px){

    /*
     * Some old MyTel pages still contain their own embedded header.
     * The dedicated mobile nav is #mytel-mnav, so every legacy header
     * must disappear on mobile.
     */
    .mytel-page > .mytel-header,
    .mytel-header,
    .mytel-header-inner,
    .mytel-nav,
    .mytel-menu{
        display:none!important;
    }

    /*
     * SERVICES TEMPLATE
     * The desktop version uses absolute nodes around a circle.
     * On mobile we intentionally remove the orbit/rings and turn
     * the same content into a readable two-column grid.
     */
    .mytel-services-v3 .hero-visual{
        min-height:0!important;
        height:auto!important;
        width:100%!important;
        max-width:100%!important;
        padding:0!important;
        margin:18px auto 0!important;
        display:block!important;
        order:0!important;
    }

    .mytel-services-v3 .service-orbit{
        position:relative!important;
        width:min(100%,430px)!important;
        max-width:430px!important;
        height:auto!important;
        min-height:0!important;
        aspect-ratio:auto!important;

        margin:0 auto!important;
        padding:12px!important;

        display:grid!important;
        grid-template-columns:repeat(2,minmax(0,1fr))!important;
        gap:10px!important;

        border-radius:22px!important;
        border:1px solid rgba(255,255,255,.10)!important;

        background:
            linear-gradient(145deg,rgba(17,42,72,.82),rgba(7,19,33,.94))!important;

        box-shadow:0 18px 42px rgba(0,0,0,.24)!important;

        animation:none!important;
        transform:none!important;
        overflow:hidden!important;
    }

    .mytel-services-v3 .service-orbit::before,
    .mytel-services-v3 .service-orbit::after{
        display:none!important;
        content:none!important;
        animation:none!important;
    }

    .mytel-services-v3 .orbit-center,
    .mytel-services-v3 .orbit-node,
    .mytel-services-v3 .n1,
    .mytel-services-v3 .n2,
    .mytel-services-v3 .n3,
    .mytel-services-v3 .n4,
    .mytel-services-v3 .n5,
    .mytel-services-v3 .n6{
        position:relative!important;

        top:auto!important;
        right:auto!important;
        bottom:auto!important;
        left:auto!important;
        inset:auto!important;

        transform:none!important;

        width:100%!important;
        max-width:none!important;
        height:auto!important;
        min-height:82px!important;

        margin:0!important;
        padding:12px 9px!important;

        border-radius:15px!important;

        display:flex!important;
        flex-direction:column!important;
        align-items:center!important;
        justify-content:center!important;
        gap:5px!important;

        text-align:center!important;

        animation:none!important;
    }

    .mytel-services-v3 .orbit-center{
        grid-column:1 / -1!important;
        min-height:108px!important;
        order:-1!important;

        background:
            linear-gradient(145deg,rgba(22,139,255,.90),rgba(8,34,67,.96))!important;

        border:1px solid rgba(91,169,255,.35)!important;

        font-size:15px!important;
        line-height:1.7!important;

        box-shadow:0 12px 28px rgba(22,139,255,.18)!important;
    }

    .mytel-services-v3 .orbit-node{
        background:rgba(255,255,255,.055)!important;
        border:1px solid rgba(255,255,255,.10)!important;

        font-size:12px!important;
        line-height:1.6!important;

        backdrop-filter:none!important;
        -webkit-backdrop-filter:none!important;
    }

    .mytel-services-v3 .orbit-node:hover{
        margin:0!important;
        transform:none!important;
        box-shadow:none!important;
    }

    .mytel-services-v3 .orbit-node b{
        display:block!important;
        margin:0 0 2px!important;
        font-size:22px!important;
        line-height:1!important;
    }

    /*
     * NEW VOIP SUPPORT PAGE
     * Same mobile principle: no circular absolute positioning.
     */
    .mytel-support-v2 .support-visual{
        width:100%!important;
        max-width:520px!important;
        min-height:0!important;
        height:auto!important;
        margin:18px auto 0!important;
        padding:12px!important;
        border-radius:22px!important;
    }

    .mytel-support-v2 .orbit{
        position:relative!important;
        width:100%!important;
        max-width:100%!important;
        height:auto!important;
        min-height:0!important;

        margin:0!important;
        padding:0!important;

        display:grid!important;
        grid-template-columns:repeat(2,minmax(0,1fr))!important;
        gap:10px!important;
    }

    .mytel-support-v2 .orbit-ring{
        display:none!important;
    }

    .mytel-support-v2 .center-node,
    .mytel-support-v2 .support-node,
    .mytel-support-v2 .node-top,
    .mytel-support-v2 .node-tr,
    .mytel-support-v2 .node-rb,
    .mytel-support-v2 .node-bottom,
    .mytel-support-v2 .node-lb,
    .mytel-support-v2 .node-tl{
        position:relative!important;

        inset:auto!important;
        top:auto!important;
        right:auto!important;
        bottom:auto!important;
        left:auto!important;

        transform:none!important;

        width:100%!important;
        max-width:none!important;
        height:auto!important;
        min-height:82px!important;

        margin:0!important;
        padding:12px 8px!important;

        border-radius:15px!important;
    }

    .mytel-support-v2 .center-node{
        grid-column:1 / -1!important;
        min-height:108px!important;
        order:-1!important;
    }
}

@media (max-width:430px){

    .mytel-services-v3 .service-orbit,
    .mytel-support-v2 .orbit{
        grid-template-columns:repeat(2,minmax(0,1fr))!important;
        gap:8px!important;
    }

    .mytel-services-v3 .orbit-center,
    .mytel-services-v3 .orbit-node,
    .mytel-support-v2 .center-node,
    .mytel-support-v2 .support-node{
        min-height:76px!important;
        padding:10px 7px!important;
    }

    .mytel-services-v3 .orbit-center,
    .mytel-support-v2 .center-node{
        min-height:100px!important;
    }
}

</style>
<style id="mytel-mobile-final-cleanup-css">

@media (max-width:900px){

    /*
     * Keep ONLY the dedicated hamburger header.
     */
    body > header:not(#mytel-mnav),
    header#header,
    .site-header,
    .ct-header,
    .ct-header-wrapper,
    .elementor-location-header,
    .elementor-115,
    [data-elementor-id="115"],
    [data-elementor-post-id="115"],
    .mytel-header,
    .mytel-home-header,
    .mytel-page > .mytel-header{
        display:none!important;
        visibility:hidden!important;
        pointer-events:none!important;
        height:0!important;
        min-height:0!important;
        max-height:0!important;
        margin:0!important;
        padding:0!important;
        border:0!important;
        overflow:hidden!important;
    }

    /*
     * Strongly restore the dedicated mobile bar after the generic rules above.
     */
    #mytel-mnav{
        display:block!important;
        visibility:visible!important;
        pointer-events:auto!important;
        width:100%!important;
        height:68px!important;
        min-height:68px!important;
        max-height:none!important;
        overflow:visible!important;
        margin:0!important;
        padding:0!important;
    }

    /*
     * Avoid a second WordPress/theme mobile trigger.
     */
    .ct-header-trigger,
    .ct-mobile-menu,
    .mobile-menu-trigger,
    .mobile-menu-container,
    .ct-drawer-canvas,
    .ct-panel,
    .ct-offcanvas,
    #offcanvas{
        display:none!important;
        visibility:hidden!important;
        pointer-events:none!important;
    }
}

</style>
	</head>


