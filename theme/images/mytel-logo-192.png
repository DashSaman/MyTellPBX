  }
}


/* MyTel Mobile Menu Better Layout */

@media (max-width: 900px) {
  .mytel-page .mytel-header {
    padding: 18px 0 16px !important;
  }

  .mytel-page .mytel-header-inner {
    flex-direction: column !important;
