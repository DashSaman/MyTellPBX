  background: linear-gradient(135deg, #ff8a00 0%, #ffb347 100%) !important;
  background-color: #ff8a00 !important;
  color: #020914 !important;

  border: 1px solid rgba(255, 138, 0, 1) !important;
  border-radius: 14px !important;

  font-size: 15px !important;
  font-weight: 950 !important;
  text-align: center !important;

  cursor: pointer !important;
  box-shadow: 0 16px 42px rgba(255, 138, 0, 0.34) !important;
  transition: all 0.25s ease !important;
  opacity: 1 !important;
}

/* وقتی موس میره روش، نارنجی روشن‌تر شود */
body:has(.wpcf7) form.wpcf7-form input[type="submit"].wpcf7-submit:hover,
