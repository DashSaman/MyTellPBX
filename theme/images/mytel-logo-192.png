  background: #020914 !important;
}

body:has(.wpcf7) .entry-header,
body:has(.wpcf7) .page-title {
  color: #ffffff !important;
  text-align: center !important;
  margin-bottom: 30px !important;
}

.wpcf7 {
  direction: rtl;
  max-width: 900px;
  margin: 40px auto 70px auto !important;
  padding: 34px;
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 24px;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
}

.wpcf7 label {
  display: block;
  color: #ffffff !important;
  font-weight: 800;
  margin-bottom: 18px;
}

.wpcf7 input,
.wpcf7 select,
.wpcf7 textarea {
  width: 100% !important;
  margin-top: 8px;
  padding: 14px 16px !important;
  border-radius: 12px !important;
  border: 1px solid rgba(255, 255, 255, 0.14) !important;
  background: rgba(2, 9, 20, 0.75) !important;
  color: #ffffff !important;
  font-size: 14px !important;
  outline: none !important;
}

.wpcf7 input::placeholder,
.wpcf7 textarea::placeholder {
  color: #8fa3bd !important;
}

.wpcf7 input:focus,
.wpcf7 select:focus,
.wpcf7 textarea:focus {
  border-color: #168bff !important;
  box-shadow: 0 0 0 3px rgba(22, 139, 255, 0.18) !important;
}

.wpcf7 textarea {
  min-height: 170px;
  resize: vertical;
}

.wpcf7-submit {
  width: auto !important;
  min-width: 210px;
  cursor: pointer;
  background: linear-gradient(135deg, #0a67ff, #168bff) !important;
  border: none !important;
  color: #ffffff !important;
  font-weight: 900 !important;
  box-shadow: 0 14px 35px rgba(22, 139, 255, 0.28);
  transition: 0.25s ease;
}

.wpcf7-submit:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 42px rgba(22, 139, 255, 0.36);
}

.wpcf7-response-output {
  border-radius: 14px !important;
  padding: 14px 18px !important;
  color: #ffffff !important;
  background: rgba(0, 194, 184, 0.10) !important;
  border-color: #00c2b8 !important;
}

.wpcf7-not-valid-tip {
  color: #ff8a00 !important;
  font-size: 13px;
  margin-top: 6px;
}

@media (max-width: 768px) {
  .wpcf7 {
    margin: 24px 16px 50px 16px !important;
    padding: 22px;
  }

  .wpcf7-submit {
    width: 100% !important;
  }
}

