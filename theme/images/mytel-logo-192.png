  border-color: #ffb347 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 22px 52px rgba(255, 138, 0, 0.46) !important;
}

/* وقتی کلیک شد یا انتخاب شد، آبی شود */
body:has(.wpcf7) form.wpcf7-form input[type="submit"].wpcf7-submit:active,
body:has(.wpcf7) form.wpcf7-form input[type="submit"].wpcf7-submit:focus,
body:has(.wpcf7) .wpcf7 form input[type="submit"]:active,
body:has(.wpcf7) .wpcf7 form input[type="submit"]:focus,
body:has(.wpcf7) .wpcf7-submit:active,
body:has(.wpcf7) .wpcf7-submit:focus {
  background: linear-gradient(135deg, #0a67ff 0%, #168bff 100%) !important;
  background-color: #168bff !important;
  color: #ffffff !important;
  border-color: #168bff !important;
  transform: translateY(0) !important;
  box-shadow: 0 0 0 4px rgba(22, 139, 255, 0.24),
              0 18px 44px rgba(22, 139, 255, 0.36) !important;
  outline: none !important;
}

/* پیام موفقیت سبز باشد */
body:has(.wpcf7) .wpcf7 form.sent .wpcf7-response-output {
  color: #ffffff !important;
  background: rgba(0, 194, 184, 0.14) !important;
  border: 1px solid #00c2b8 !important;
  border-radius: 14px !important;
  padding: 15px 18px !important;
  text-align: center !important;
  font-weight: 900 !important;
}

/* پیام خطا قرمز/نارنجی باشد، نه سبز */
body:has(.wpcf7) .wpcf7 form.invalid .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.failed .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.spam .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.unaccepted .wpcf7-response-output {
  color: #ffffff !important;
  background: rgba(255, 82, 82, 0.14) !important;
  border: 1px solid #ff5252 !important;
  border-radius: 14px !important;
  padding: 15px 18px !important;
  text-align: center !important;
  font-weight: 900 !important;
}

/* خطای زیر هر فیلد نارنجی باشد */
body:has(.wpcf7) .wpcf7-not-valid-tip {
  color: #ff8a00 !important;
  font-size: 13px !important;
  font-weight: 800 !important;
  margin-top: 7px !important;
}



/* MyTel Contact Form Message Colors */

/* پیام موفقیت: سبز */
body:has(.wpcf7) .wpcf7 form.sent .wpcf7-response-output {
  color: #ffffff !important;
  background: rgba(0, 194, 184, 0.14) !important;
  border: 1px solid #00c2b8 !important;
  border-radius: 14px !important;
  padding: 15px 18px !important;
  text-align: center !important;
  font-weight: 900 !important;
  box-shadow: 0 0 24px rgba(0, 194, 184, 0.18) !important;
}

/* پیام خطا: قرمز */
body:has(.wpcf7) .wpcf7 form.invalid .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.failed .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.spam .wpcf7-response-output,
body:has(.wpcf7) .wpcf7 form.unaccepted .wpcf7-response-output {
  color: #ffffff !important;
  background: rgba(255, 82, 82, 0.16) !important;
  border: 1px solid #ff5252 !important;
  border-radius: 14px !important;
  padding: 15px 18px !important;
  text-align: center !important;
  font-weight: 900 !important;
  box-shadow: 0 0 24px rgba(255, 82, 82, 0.20) !important;
}

/* خطای زیر هر فیلد: نارنجی */
body:has(.wpcf7) .wpcf7-not-valid-tip {
  color: #ff8a00 !important;
  font-size: 13px !important;
  font-weight: 800 !important;
  margin-top: 7px !important;
}



/* MyTel Global Glass Animation */

/* ورود نرم هدر */
@keyframes mytelHeaderIn {
  0% {
    opacity: 0;
    transform: translateY(-18px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ورود عنوان‌ها */
@keyframes mytelHeroIn {
  0% {
    opacity: 0;
    transform: translateY(28px) scale(.98);
    filter: blur(5px);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

/* ورود کارت‌های شیشه‌ای */
@keyframes mytelGlassIn {
  0% {
    opacity: 0;
    transform: translateY(45px) scale(.94) rotateX(10deg);
    filter: blur(7px);
  }
  65% {
    opacity: 1;
    transform: translateY(-6px) scale(1.015) rotateX(0deg);
    filter: blur(0);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0deg);
    filter: blur(0);
  }
}

/* تکان خیلی ملایم لوگو */
@keyframes mytelLogoPop {
  0% {
    opacity: 0;
    transform: scale(.75) rotate(-8deg);
  }
  70% {
    opacity: 1;
    transform: scale(1.08) rotate(2deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

/* هدر */
.mytel-page .mytel-header {
  animation: mytelHeaderIn .65s ease both;
}

/* لوگو */
.mytel-page .mytel-logo {
  animation: mytelLogoPop .8s ease both;
  animation-delay: .15s;
}

/* متن‌های بالای صفحه */
.mytel-page .hero .badge {
  animation: mytelHeroIn .7s ease both;
  animation-delay: .12s;
}

.mytel-page .hero h1 {
  animation: mytelHeroIn .8s ease both;
  animation-delay: .22s;
}

.mytel-page .hero p {
  animation: mytelHeroIn .85s ease both;
  animation-delay: .34s;
}

/* کارت‌ها و فرم‌های شیشه‌ای همه صفحات */
.mytel-page .service-card,
.mytel-page .solution-card,
.mytel-page .price-card,
.mytel-page .about-card,
.mytel-page .about-visual,
.mytel-page .visual-box,
.mytel-page .value-card,
.mytel-page .expertise-card,
.mytel-page .compare-card,
.mytel-page .step-card,
.mytel-page .process-card,
.mytel-page .note-card,
.mytel-page .faq-item,
.mytel-page .info-card,
.mytel-page .form-card,
.mytel-page .contact-item,
.mytel-page .stat-item,
.mytel-page .cta-box {
  opacity: 0;
  transform-origin: center bottom;
  animation: mytelGlassIn .85s cubic-bezier(.18,.89,.32,1.18) both;
  will-change: transform, opacity, filter;
}

/* تأخیر مرحله‌ای برای کارت‌ها */
.mytel-page .service-card:nth-child(1),
.mytel-page .solution-card:nth-child(1),
.mytel-page .price-card:nth-child(1),
.mytel-page .value-card:nth-child(1),
.mytel-page .step-card:nth-child(1),
.mytel-page .faq-item:nth-child(1),
.mytel-page .contact-item:nth-child(1),
.mytel-page .stat-item:nth-child(1) {
  animation-delay: .12s;
}

.mytel-page .service-card:nth-child(2),
.mytel-page .solution-card:nth-child(2),
.mytel-page .price-card:nth-child(2),
.mytel-page .value-card:nth-child(2),
.mytel-page .step-card:nth-child(2),
.mytel-page .faq-item:nth-child(2),
.mytel-page .contact-item:nth-child(2),
.mytel-page .stat-item:nth-child(2) {
  animation-delay: .22s;
}

.mytel-page .service-card:nth-child(3),
.mytel-page .solution-card:nth-child(3),
.mytel-page .price-card:nth-child(3),
.mytel-page .value-card:nth-child(3),
.mytel-page .step-card:nth-child(3),
.mytel-page .faq-item:nth-child(3),
.mytel-page .contact-item:nth-child(3),
.mytel-page .stat-item:nth-child(3) {
  animation-delay: .32s;
}

.mytel-page .service-card:nth-child(4),
.mytel-page .solution-card:nth-child(4),
.mytel-page .price-card:nth-child(4),
.mytel-page .step-card:nth-child(4),
.mytel-page .faq-item:nth-child(4),
.mytel-page .contact-item:nth-child(4),
.mytel-page .stat-item:nth-child(4) {
  animation-delay: .42s;
}

.mytel-page .service-card:nth-child(5),
.mytel-page .solution-card:nth-child(5) {
  animation-delay: .52s;
}

.mytel-page .service-card:nth-child(6),
.mytel-page .solution-card:nth-child(6) {
  animation-delay: .62s;
}

/* کارت‌های دوتایی */
.mytel-page .about-card,
.mytel-page .compare-card:first-child,
.mytel-page .info-card {
  animation-delay: .18s;
}

.mytel-page .about-visual,
.mytel-page .compare-card:last-child,
.mytel-page .form-card {
  animation-delay: .32s;
}

/* CTA پایین صفحه */
.mytel-page .cta-box {
  animation-delay: .25s;
}

/* افکت حرفه‌ای موقع رفتن موس روی کارت‌ها */
.mytel-page .service-card:hover,
.mytel-page .solution-card:hover,
.mytel-page .price-card:hover,
.mytel-page .value-card:hover,
.mytel-page .expertise-card:hover,
.mytel-page .compare-card:hover,
.mytel-page .step-card:hover,
.mytel-page .process-card:hover,
.mytel-page .note-card:hover,
.mytel-page .faq-item:hover,
.mytel-page .info-card:hover,
.mytel-page .form-card:hover {
  transform: translateY(-7px) scale(1.012) !important;
  transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
  border-color: rgba(255, 138, 0, .45) !important;
  box-shadow: 0 24px 70px rgba(0, 0, 0, .38), 0 0 28px rgba(22, 139, 255, .10) !important;
}

/* احترام به حالت کاهش حرکت مرورگر */
@media (prefers-reduced-motion: reduce) {
  .mytel-page * {
    animation: none !important;
    transition: none !important;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
}

/* MyTel Global Mobile Optimization */

@media (max-width: 900px) {
  html,
  body {
    overflow-x: hidden !important;
  }

  .mytel-page {
    overflow-x: hidden !important;
  }

  .mytel-wrap {
    width: 92% !important;
    max-width: 92% !important;
  }

  /* Header */
  .mytel-page .mytel-header {
    padding: 14px 0 !important;
  }

  .mytel-page .mytel-header-inner {
    flex-direction: column !important;
    gap: 14px !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .mytel-page .mytel-brand,
  .mytel-page .mytel-logo {
    justify-content: center !important;
  }

  .mytel-page .mytel-brand-svg {
    width: 58px !important;
    height: 42px !important;
  }

  .mytel-page .mytel-brand-text,
  .mytel-page .mytel-logo-text {
    font-size: 24px !important;
  }

  /* Menu Mobile Scroll */
  .mytel-page .mytel-menu,
  .mytel-page .mytel-nav {
    width: 100% !important;
    max-width: 100% !important;
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    justify-content: flex-start !important;
    gap: 10px !important;
    padding: 8px 2px 10px !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch !important;
  }

  .mytel-page .mytel-menu::-webkit-scrollbar,
  .mytel-page .mytel-nav::-webkit-scrollbar {
    display: none !important;
  }

  .mytel-page .mytel-menu li {
    flex: 0 0 auto !important;
  }

  .mytel-page .mytel-menu a,
  .mytel-page .mytel-nav a {
    flex: 0 0 auto !important;
    font-size: 12.5px !important;
    padding: 8px 12px !important;
    border-radius: 999px !important;
    background: rgba(255,255,255,.055) !important;
    border: 1px solid rgba(255,255,255,.08) !important;
    white-space: nowrap !important;
  }

  .mytel-page .mytel-menu a.active,
  .mytel-page .mytel-nav a.active {
    color: #ffffff !important;
    background: rgba(22,139,255,.18) !important;
    border-color: rgba(22,139,255,.45) !important;
