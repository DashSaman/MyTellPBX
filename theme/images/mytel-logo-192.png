  .mytel-page .note-grid,
  .mytel-page .expertise-grid {
    grid-template-columns: 1fr !important;
  }

  .mytel-page .mytel-content,
  .mytel-page .hero {
    text-align: center !important;
  }

  .mytel-page .mytel-title,
  .mytel-page .hero h1 {
    font-size: 34px !important;
    line-height: 1.45 !important;
    letter-spacing: -0.5px !important;
  }

  .mytel-page .mytel-title .title-line {
    white-space: normal !important;
  }

  .mytel-page .mytel-subtitle,
  .mytel-page .hero p {
    font-size: 14px !important;
    line-height: 2 !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .mytel-page .mytel-badge,
  .mytel-page .badge {
    font-size: 12px !important;
    padding: 8px 13px !important;
    margin-bottom: 18px !important;
  }

  /* Buttons */
  .mytel-page .mytel-buttons {
    width: 100% !important;
    justify-content: center !important;
    gap: 10px !important;
  }

  .mytel-page .mytel-btn,
  .mytel-page .btn {
    width: 100% !important;
    max-width: 320px !important;
    min-height: 48px !important;
