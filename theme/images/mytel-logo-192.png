  .mytel-page .contact-section,
  .mytel-page .case-section {
    padding: 42px 0 !important;
  }

  /* CTA */
  .mytel-page .mytel-cta,
  .mytel-page .cta-box {
    flex-direction: column !important;
    text-align: center !important;
    padding: 24px !important;
    border-radius: 22px !important;
  }

  .mytel-page .mytel-cta h2,
  .mytel-page .cta-box h2 {
    font-size: 24px !important;
    line-height: 1.7 !important;
  }

  /* Footer */
  .mytel-page .mytel-footer,
  .mytel-page .mytel-footer-grid,
  .mytel-page .footer-grid {
    text-align: center !important;
  }

  .mytel-page .mytel-footer {
    padding: 34px 0 22px !important;
  }

  /* Contact Form */
  .mytel-page .form-card .wpcf7 input,
  .mytel-page .form-card .wpcf7 select,
  .mytel-page .form-card .wpcf7 textarea {
