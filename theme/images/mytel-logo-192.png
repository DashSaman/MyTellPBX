<script id="tahefobu-navigation-menu-script-js" src="https://mytel.one/wp-content/plugins/header-footer-builder-for-elementor/assets/js/navigation-menu-hf.js?ver=1.3.3"></script>
		<script>
		(function () {
			'use strict';
			if (window.__mytelLt) return; window.__mytelLt = true;
			var send = function (name, param) {
				// Fire only when GA4 is present; single call path = no duplicate events.
				if (typeof window.gtag === 'function') {
					window.gtag('event', name, param || {});
				}
				// dataLayer always available for GTM users/debug.
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push(Object.assign({ event: name }, param || {}));
			};
			var handler = function (e) {
				var a = e.target.closest ? e.target.closest('a') : null;
				if (!a) return;
				var href = a.getAttribute('href') || '';
				if (/^tel:/i.test(href)) { send('phone_click', { link_url: href }); return; }
				if (/^mailto:/i.test(href)) { send('email_click', { link_url: href }); return; }
				if (/wa\.me|whatsapp/i.test(href)) { send('whatsapp_click', { link_url: href }); return; }
				if (/\/pricing\//.test(a.pathname || '')) { send('pricing_click', { link_url: a.href }); return; }
			};
			document.addEventListener('click', handler, { passive: true });
			// Contact Form 7 success (one successful mail = one event)
			document.addEventListener('wpcf7mailsent', function () {
				send('contact_form_submit', { form: 'contact' });
			});
		})();
		</script>
		<script id="mytel-mobile-nav-v2-js">
(function(){

    const header = document.getElementById('mytel-mnav');
    const toggle = document.getElementById('mytel-mnav-toggle');
    const drawer = document.getElementById('mytel-mnav-drawer');
    const menu   = document.getElementById('mytel-mnav-menu');

    if (!header || !toggle || !drawer || !menu) {
        return;
    }

    function openDrawer(){
        header.classList.add('open');
        document.body.classList.add('mytel-mnav-lock');
        toggle.setAttribute('aria-expanded','true');
        toggle.setAttribute('aria-label','بستن منو');
        drawer.setAttribute('aria-hidden','false');
    }

    function closeDrawer(){
        header.classList.remove('open');
        document.body.classList.remove('mytel-mnav-lock');
        toggle.setAttribute('aria-expanded','false');
        toggle.setAttribute('aria-label','باز کردن منو');
        drawer.setAttribute('aria-hidden','true');
    }

    toggle.addEventListener('click', function(event){
        event.preventDefault();

        if (header.classList.contains('open')) {
            closeDrawer();
        } else {
            openDrawer();
        }
    });

    /*
     * IMPORTANT:
     * Clicking "خدمات" itself no longer navigates to /services/.
     * It opens the submenu first.
     * A new first submenu row is created for "مشاهده همه خدمات".
     * Same behavior applies to every other parent such as "راهنما و ابزارها".
     */
    menu.querySelectorAll('li.menu-item-has-children').forEach(function(item){

        const parentLink = item.querySelector(':scope > a');
        const submenu    = item.querySelector(':scope > .sub-menu');

        if (!parentLink || !submenu) {
            return;
        }

        const destination = parentLink.getAttribute('href');
        const parentTitle = parentLink.textContent.trim();

        if (
            destination &&
            destination !== '#' &&
            !submenu.querySelector(':scope > .mytel-mobile-parent-destination')
        ) {
            const li = document.createElement('li');
            li.className = 'mytel-mobile-parent-destination menu-item';

            const a = document.createElement('a');
            a.href = destination;
            a.textContent = 'مشاهده همه «' + parentTitle + '»';

            li.appendChild(a);
            submenu.insertBefore(li, submenu.firstChild);
        }

        parentLink.setAttribute('href','#');
        parentLink.setAttribute('role','button');
        parentLink.setAttribute('aria-expanded','false');

        parentLink.addEventListener('click', function(event){
            event.preventDefault();
            event.stopPropagation();

            const willOpen = !item.classList.contains('mytel-sub-open');

            /*
             * Keep only one top-level submenu open for a cleaner mobile menu.
             */
            if (item.parentElement === menu) {
                menu.querySelectorAll(':scope > li.mytel-sub-open').forEach(function(other){
                    if (other !== item) {
                        other.classList.remove('mytel-sub-open');
                        const otherLink = other.querySelector(':scope > a');
                        if (otherLink) {
                            otherLink.setAttribute('aria-expanded','false');
                        }
                    }
                });
            }

            item.classList.toggle('mytel-sub-open', willOpen);
            parentLink.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });
    });

    menu.querySelectorAll('a').forEach(function(link){
        link.addEventListener('click', function(){
            const parent = link.parentElement;

            if (!parent || !parent.classList.contains('menu-item-has-children')) {
                closeDrawer();
            }
        });
    });

    document.addEventListener('keydown', function(event){
        if (event.key === 'Escape') {
            closeDrawer();
        }
    });

    window.addEventListener('resize', function(){
        if (window.innerWidth > 900) {
            closeDrawer();
        }
    });

})();
</script>
<script id="mytel-mobile-final-cleanup-js">
(function(){

    const mq = window.matchMedia('(max-width: 900px)');

    function cleanLegacyHeaders(){

        if (!mq.matches) {
            return;
        }

        const mobileHeader = document.getElementById('mytel-mnav');

        if (!mobileHeader) {
            return;
        }

        document.querySelectorAll('header').forEach(function(el){
            if (
                el !== mobileHeader &&
                !el.contains(mobileHeader) &&
                !mobileHeader.contains(el)
            ) {
                el.classList.add('mytel-legacy-header-hidden');
                el.style.setProperty('display','none','important');
                el.style.setProperty('visibility','hidden','important');
                el.style.setProperty('height','0','important');
                el.style.setProperty('min-height','0','important');
                el.style.setProperty('max-height','0','important');
                el.style.setProperty('margin','0','important');
                el.style.setProperty('padding','0','important');
                el.style.setProperty('overflow','hidden','important');
                el.style.setProperty('pointer-events','none','important');
            }
        });

        [
            '.elementor-115',
            '[data-elementor-id="115"]',
            '[data-elementor-post-id="115"]',
            '.elementor-location-header',
            '.ct-header',
            '.ct-header-wrapper',
            '.site-header',
            '.mytel-header',
            '.mytel-home-header'
        ].forEach(function(selector){
            document.querySelectorAll(selector).forEach(function(el){
                if (
                    el !== mobileHeader &&
                    !el.contains(mobileHeader) &&
                    !mobileHeader.contains(el)
                ) {
                    el.style.setProperty('display','none','important');
                    el.style.setProperty('visibility','hidden','important');
                    el.style.setProperty('height','0','important');
                    el.style.setProperty('margin','0','important');
                    el.style.setProperty('padding','0','important');
                    el.style.setProperty('overflow','hidden','important');
                    el.style.setProperty('pointer-events','none','important');
                }
            });
        });

        mobileHeader.style.setProperty('display','block','important');
        mobileHeader.style.setProperty('visibility','visible','important');
        mobileHeader.style.setProperty('height','68px','important');
        mobileHeader.style.setProperty('min-height','68px','important');
        mobileHeader.style.setProperty('overflow','visible','important');
        mobileHeader.style.setProperty('pointer-events','auto','important');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', cleanLegacyHeaders);
    } else {
        cleanLegacyHeaders();
    }

    window.addEventListener('load', cleanLegacyHeaders);

    /*
     * Elementor/header scripts may inject markup shortly after load.
     * Re-run briefly to remove those late duplicate headers.
     */
    let runs = 0;
    const timer = setInterval(function(){
        cleanLegacyHeaders();
        runs += 1;
        if (runs >= 8) {
            clearInterval(timer);
        }
    }, 350);

})();
</script>

</body>
</html>
