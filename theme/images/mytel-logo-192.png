  border-radius: 14px !important;

  font-size: 15px !important;
  font-weight: 950 !important;
  cursor: pointer !important;

  box-shadow: 0 16px 40px rgba(255, 138, 0, 0.30) !important;
  transition: 0.25s ease !important;
}

/* وقتی موس میره روش، فقط کمی روشن‌تر بشه */
body:has(.wpcf7) .wpcf7-submit:hover {
  background: linear-gradient(135deg, #ff9d1a, #ffc266) !important;
  color: #020914 !important;
  border-color: #ffb347 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 20px 46px rgba(255, 138, 0, 0.40) !important;
}

/* وقتی کلیک شد یا با کیبورد انتخاب شد، آبی بشه */
