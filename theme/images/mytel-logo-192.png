    <style>
      

      #mytel-clean-global-header,
      #mytel-clean-global-header * {
        box-sizing: border-box;
        font-family: Vazirmatn, Tahoma, Arial, sans-serif !important;
      }

      #mytel-clean-global-header {
        width: 100%;
        background: rgba(2, 9, 20, .98);
        border-bottom: 1px solid rgba(255,255,255,.08);
        position: relative;
        z-index: 9999;
        direction: rtl;
      }

      .mytel-clean-header-wrap {
        width: min(1260px, 92%);
        max-width: 1260px;
        min-height: 86px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .mytel-clean-logo {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        direction: ltr;
        text-decoration: none !important;
        flex: 0 0 auto;
        min-width: 215px;
      }

      .mytel-clean-logo-icon {
        width: 70px;
        height: auto;
        display: block;
        filter: drop-shadow(0 0 12px rgba(22,139,255,.25));
      }

      .mytel-clean-logo-text {
        font-family: Arial, Tahoma, sans-serif !important;
        font-size: 30px;
        font-weight: 950;
        line-height: 1;
        letter-spacing: -1px;
        color: #ffffff;
        white-space: nowrap;
      }

      .mytel-clean-logo-text span {
        color: #ff8a00;
      }

      .mytel-clean-nav {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
      }

      .mytel-clean-menu {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
        gap: 22px;
        flex-wrap: nowrap;
      }

      .mytel-clean-menu li {
        position: relative;
        margin: 0 !important;
        padding: 0 !important;
      }

      .mytel-clean-menu a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #d7e7ff !important;
        text-decoration: none !important;
        font-size: 13.5px;
        font-weight: 850;
        line-height: 1;
        white-space: nowrap;
        transition: .25s ease;
        padding: 10px 0;
        position: relative;
      }

      .mytel-clean-menu a:hover,
      .mytel-clean-menu .current-menu-item > a,
      .mytel-clean-menu .current_page_item > a {
        color: #168bff !important;
      }

      .mytel-clean-menu .current-menu-item > a:after,
      .mytel-clean-menu .current_page_item > a:after {
        content: "";
        position: absolute;
        right: 0;
        left: 0;
        bottom: -11px;
        height: 2px;
        border-radius: 999px;
        background: #168bff;
      }

      .mytel-clean-menu .menu-item-has-children > a {
        gap: 7px;
      }

      .mytel-clean-menu .menu-item-has-children > a::before {
        content: "";
        display: inline-block;
        width: 7px;
        height: 7px;
        border-left: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(-45deg) translateY(-1px);
        transition: transform .25s ease, color .25s ease;
        opacity: .95;
        flex: 0 0 auto;
      }

      .mytel-clean-menu .menu-item-has-children:hover > a::before,
      .mytel-clean-menu .menu-item-has-children.current-menu-item > a::before,
      .mytel-clean-menu .menu-item-has-children.current_page_item > a::before {
        transform: rotate(135deg) translateY(-1px);
      }

      .mytel-clean-menu .sub-menu {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 230px;
        padding: 10px;
        margin: 12px 0 0 !important;
        list-style: none !important;
        background: #041223;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 16px;
        box-shadow: 0 20px 45px rgba(0,0,0,.35);
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: .25s ease;
      }

      .mytel-clean-menu li:hover > .sub-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .mytel-clean-menu .sub-menu a {
        width: 100%;
        justify-content: flex-start;
        padding: 11px 12px;
        border-radius: 10px;
        font-size: 13px;
      }

      .mytel-clean-menu .sub-menu a:hover {
        background: rgba(22,139,255,.12);
      }

      .mytel-clean-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        direction: rtl;
        min-width: 300px;
      }

      .mytel-clean-phone {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        direction: ltr;
        min-width: 132px;
        min-height: 42px;
        padding: 7px 15px;
        border: 1px solid rgba(255, 138, 0, .85);
        border-radius: 999px;
        background: rgba(255, 138, 0, .055);
        box-shadow: 0 0 18px rgba(255, 138, 0, .08);
        text-decoration: none !important;
        transition: .25s ease;
      }

      .mytel-clean-phone span {
        color: #ff8a00;
        font-family: Arial, Tahoma, sans-serif !important;
        font-size: 13px;
        font-weight: 900;
        line-height: 1.25;
        white-space: nowrap;
        transition: .25s ease;
      }

      .mytel-clean-phone:hover {
        background: rgba(255, 138, 0, .14);
        border-color: #ffb13b;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255, 138, 0, .18);
      }

      .mytel-clean-phone:hover span {
        color: #ffb13b;
      }

      .mytel-clean-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 125px;
        min-height: 42px;
        padding: 9px 16px;
        border-radius: 999px;
        background: linear-gradient(135deg, #ff8a00, #ff9f22);
        color: #ffffff !important;
        font-size: 13px;
        font-weight: 900;
        line-height: 1;
        text-decoration: none !important;
        box-shadow: 0 8px 20px rgba(255, 138, 0, .18);
        transition: .25s ease;
        white-space: nowrap;
      }

      .mytel-clean-cta:hover {
        background: linear-gradient(135deg, #168bff, #0a67ff);
        color: #ffffff !important;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(22, 139, 255, .24);
      }

      @media (max-width: 1180px) {
        .mytel-clean-header-wrap {
          width: min(1180px, 94%);
          gap: 14px;
        }

        .mytel-clean-logo {
          min-width: 195px;
        }

        .mytel-clean-logo-icon {
          width: 62px;
        }

        .mytel-clean-logo-text {
          font-size: 27px;
        }

        .mytel-clean-menu {
