        }

        .mytel-clean-actions {
          min-width: 270px;
        }
      }

      @media (max-width: 980px) {
        .mytel-clean-header-wrap {
          min-height: auto;
          padding: 15px 0;
          flex-direction: column;
          gap: 14px;
        }

        .mytel-clean-logo {
          min-width: auto;
        }

        .mytel-clean-menu {
