  .mytel-page .solution-card,
  .mytel-page .service-card,
  .mytel-page .value-card,
  .mytel-page .faq-item,
  .mytel-page .info-card,
  .mytel-page .form-card,
  .mytel-page .about-card,
  .mytel-page .note-card,
  .mytel-page .case-card,
  .mytel-page .case-side,
  .mytel-page .timeline-card,
  .mytel-page .industry-card,
  .mytel-page .mytel-project-card,
  .mytel-page .mytel-box {
