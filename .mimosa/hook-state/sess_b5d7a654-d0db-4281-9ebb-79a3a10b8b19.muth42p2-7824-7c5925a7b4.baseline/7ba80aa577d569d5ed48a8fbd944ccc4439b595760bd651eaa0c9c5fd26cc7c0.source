#!/usr/bin/env python3
"""SSH helper for the MyTel theme project: run / b64send / get on 192.168.8.171."""
import sys, os, paramiko

HOST = "192.168.8.171"
USER = "root"
PASS = "CdptPoolHs4m"

def client():
    c = paramiko.SSHClient()
    c.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    c.connect(HOST, username=USER, password=PASS, timeout=20,
              banner_timeout=20, auth_timeout=20)
    return c

def main():
    mode = sys.argv[1]
    c = client()
    try:
        if mode == "run":
            cmd = sys.argv[2]
            stdin, stdout, stderr = c.exec_command(cmd, timeout=570)
            out = stdout.read().decode("utf-8", "replace")
            err = stderr.read().decode("utf-8", "replace")
            rc = stdout.channel.recv_exit_status()
            sys.stdout.write(out)
            if err.strip():
                sys.stdout.write("\n[STDERR]\n" + err)
            sys.stdout.write("\n[RC=%d]\n" % rc)
        elif mode == "b64send":
            import base64
            local, remote = sys.argv[2], sys.argv[3]
            with open(local, "rb") as f:
                b64 = base64.b64encode(f.read()).decode()
            for i in range(0, len(b64), 60000):
                chunk = b64[i:i+60000]
                cmd = "echo %s | base64 -d >> %s" % (chunk, remote)
                stdin, stdout, stderr = c.exec_command(cmd, timeout=120)
                rc = stdout.channel.recv_exit_status()
                if rc != 0:
                    print("B64SEND chunk failed rc=%d %s" % (rc, stderr.read().decode()))
                    sys.exit(1)
            stdin, stdout, stderr = c.exec_command("wc -c %s" % remote, timeout=30)
            print("B64SEND OK", stdout.read().decode().strip())
        elif mode == "get":
            remote, local = sys.argv[2], sys.argv[3]
            sftp = c.open_sftp()
            sftp.get(remote, local)
            sftp.close()
            print("GET OK ->", local)
        elif mode == "put":
            local, remote = sys.argv[2], sys.argv[3]
            sftp = c.open_sftp()
            sftp.put(local, remote)
            sftp.close()
            print("PUT OK %s -> %s" % (os.path.getsize(local), remote))
        else:
            print("unknown mode")
            sys.exit(2)
    finally:
        c.close()

if __name__ == "__main__":
    main()
